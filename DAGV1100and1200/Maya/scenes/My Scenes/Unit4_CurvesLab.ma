	rename -uid "3CF3F054-415A-E71C-1F01-4C9ADADF3A31";
	setAttr ".f" 2;
	setAttr ".pt" 1;
	setAttr ".chr" 0.9;
	setAttr ".ut" 1;
	setAttr ".un" 16;
	setAttr ".vt" 1;
	setAttr ".vn" 17;
	setAttr ".ucr" no;
	setAttr ".cht" 0.01;
createNode polyNormal -n "polyNormal1";
	rename -uid "4F675B4F-4438-DA66-F332-20A06871ED4B";
	setAttr ".ics" -type "componentList" 1 "f[*]";
	setAttr ".unm" no;
select -ne :time1;
